# Copy to .env for local development. Every variable is prefixed BATCHLIGHT_.
BATCHLIGHT_ENV=development
BATCHLIGHT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/batchlight
BATCHLIGHT_BASE_URL=http://localhost:8000
# Set to true behind HTTPS in production.
BATCHLIGHT_SECURE_COOKIES=false
# Set to true only behind a proxy that sets X-Forwarded-For.
BATCHLIGHT_TRUST_PROXY_HEADERS=false

# Email: console (logs messages), smtp, or disabled.
BATCHLIGHT_EMAIL_BACKEND=console
BATCHLIGHT_EMAIL_FROM=Batchlight <alerts@example.org>
BATCHLIGHT_SMTP_HOST=localhost
BATCHLIGHT_SMTP_PORT=587
BATCHLIGHT_SMTP_USERNAME=
BATCHLIGHT_SMTP_PASSWORD=
BATCHLIGHT_SMTP_STARTTLS=true

# Ingestion
BATCHLIGHT_INGEST_INTERVAL_MINUTES=60
BATCHLIGHT_INGEST_SINCE=2024-01-01
# Optional: raises openFDA rate limits. Free from https://open.fda.gov/apis/authentication/
BATCHLIGHT_OPENFDA_API_KEY=
