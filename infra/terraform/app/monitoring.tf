# Site and worker alarms, sent to the same SNS topic as the database alarms (see platform/monitoring.tf).

resource "aws_cloudwatch_metric_alarm" "web_unhealthy" {
  alarm_name          = "${var.project}-web-down"
  alarm_description   = "No healthy web task behind the load balancer for 3 minutes: the site is down."
  namespace           = "AWS/ApplicationELB"
  metric_name         = "HealthyHostCount"
  dimensions          = { LoadBalancer = aws_lb.main.arn_suffix, TargetGroup = aws_lb_target_group.web.arn_suffix }
  statistic           = "Minimum"
  period              = 60
  evaluation_periods  = 3
  comparison_operator = "LessThanThreshold"
  threshold           = 1
  treat_missing_data  = "breaching"
  alarm_actions       = [local.platform.alerts_topic_arn]
  ok_actions          = [local.platform.alerts_topic_arn]
}

resource "aws_cloudwatch_metric_alarm" "web_5xx" {
  alarm_name          = "${var.project}-web-5xx"
  alarm_description   = "More than 10 server errors from the app in 5 minutes."
  namespace           = "AWS/ApplicationELB"
  metric_name         = "HTTPCode_Target_5XX_Count"
  dimensions          = { LoadBalancer = aws_lb.main.arn_suffix }
  statistic           = "Sum"
  period              = 300
  evaluation_periods  = 1
  comparison_operator = "GreaterThanThreshold"
  threshold           = 10
  treat_missing_data  = "notBreaching"
  alarm_actions       = [local.platform.alerts_topic_arn]
}

resource "aws_cloudwatch_metric_alarm" "lb_5xx" {
  alarm_name          = "${var.project}-load-balancer-5xx"
  alarm_description   = "More than 10 errors generated by the load balancer itself in 5 minutes (no healthy target, timeouts)."
  namespace           = "AWS/ApplicationELB"
  metric_name         = "HTTPCode_ELB_5XX_Count"
  dimensions          = { LoadBalancer = aws_lb.main.arn_suffix }
  statistic           = "Sum"
  period              = 300
  evaluation_periods  = 1
  comparison_operator = "GreaterThanThreshold"
  threshold           = 10
  treat_missing_data  = "notBreaching"
  alarm_actions       = [local.platform.alerts_topic_arn]
}

# ECS publishes service CPU every minute while a task runs, so missing data means no worker is running (for example
# Fargate Spot had no capacity). Data ingestion and alert emails stop until it runs again.
resource "aws_cloudwatch_metric_alarm" "worker_not_running" {
  alarm_name          = "${var.project}-worker-not-running"
  alarm_description   = "No worker task has reported for 15 minutes: data refreshes and alert emails have stopped."
  namespace           = "AWS/ECS"
  metric_name         = "CPUUtilization"
  dimensions          = { ClusterName = aws_ecs_cluster.main.name, ServiceName = aws_ecs_service.worker.name }
  statistic           = "SampleCount"
  period              = 300
  evaluation_periods  = 3
  comparison_operator = "LessThanThreshold"
  threshold           = 1
  treat_missing_data  = "breaching"
  alarm_actions       = [local.platform.alerts_topic_arn]
  ok_actions          = [local.platform.alerts_topic_arn]
}
