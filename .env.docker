# Used by docker-compose.yml. Not secret: local development only.
BATCHLIGHT_ENV=development
BATCHLIGHT_DATABASE_URL=postgresql+psycopg://batchlight:batchlight@db:5432/batchlight
BATCHLIGHT_BASE_URL=http://localhost:8000
BATCHLIGHT_EMAIL_BACKEND=smtp
BATCHLIGHT_SMTP_HOST=mail
BATCHLIGHT_SMTP_PORT=1025
BATCHLIGHT_SMTP_STARTTLS=false
BATCHLIGHT_EMAIL_FROM=Batchlight <alerts@batchlight.local>
BATCHLIGHT_INGEST_INTERVAL_MINUTES=60
